function submitHinduAnswerV2(payload){
  payload=payload||{};const raw=String(payload.questionId||'').trim(),id=raw.replace(/^HINDU_/,'');if(!id)throw new Error('Hindu word ID required');const s=sheet_(EP.sheets.hindu),row=findRow_(s,1,id);if(row<2)throw new Error('Hindu word not found');const now=new Date(),first=s.getRange(row,18).getValue();s.getRange(row,16).setValue('Completed');if(!first)s.getRange(row,18).setValue(now);s.getRange(row,19).setValue(now);const qid=resolveHinduQuestionId_(id);if(!qid)return {ok:true,correct:!!payload.localCorrect,correctKey:String(payload.correctKey||''),questionId:''};const result=submitAnswerV2({questionId:qid,selectedKey:String(payload.selectedKey||''),timeSeconds:Number(payload.timeSeconds||0),marked:false,module:'hindu',attemptId:String(payload.attemptId||'')||qid+'-HINDU-'+now.getTime()+'-'+Math.random().toString(36).slice(2,8)});return {ok:true,correct:!!result.isCorrect,correctKey:String(result.correctKey||payload.correctKey||''),questionId:qid,status:result.status};
}
