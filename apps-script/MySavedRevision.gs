function mySavedRevisionStatsV2_(rows){const active=rows.filter(x=>x.active&&!x.mastered);return {saved:rows.length,focus:active.length,newCount:active.filter(x=>x.profile.attempts===0).length,weak:active.filter(x=>x.profile.state==='Weak'||x.profile.state==='Persistent Weak').length,persistentWeak:active.filter(x=>x.profile.state==='Persistent Weak').length,difficult:active.filter(x=>x.difficult).length,starred:active.filter(x=>x.starred).length,mastered:rows.filter(x=>x.mastered).length};}
function getMySavedRevisionHub(){const rows=mySavedRevisionItemsV2_(),days=[...new Set(rows.map(x=>x.day))].sort((a,b)=>b-a).map(day=>{const part=rows.filter(x=>x.day===day);return {day,label:'Day '+day,fromDay:day,toDay:day,stats:mySavedRevisionStatsV2_(part)};});return {stats:mySavedRevisionStatsV2_(rows),days};}
function mySavedRevisionScopeV2_(scope){scope=scope||{};const from=Math.max(1,Number(scope.fromDay||1)),to=Math.max(from,Number(scope.toDay||999999));return {fromDay:from,toDay:to};}
function getMySavedRevisionItems(scope,kind){const sc=mySavedRevisionScopeV2_(scope),mode=String(kind||'all').toLowerCase();return mySavedRevisionItemsV2_().filter(x=>x.day>=sc.fromDay&&x.day<=sc.toDay).filter(x=>mode==='mastered'?x.mastered:mode==='difficult'?x.active&&!x.mastered&&x.difficult:true).sort((a,b)=>b.day-a.day||a.word.localeCompare(b.word)).map(x=>({id:x.id,word:x.word,day:x.day,state:x.profile.state,attempts:x.profile.attempts,starred:x.starred,difficult:x.difficult,mastered:x.mastered}));}
function getMySavedRevisionBatch(scope,kind,count){const sc=mySavedRevisionScopeV2_(scope),mode=String(kind||'all').toLowerCase();let rows=mySavedRevisionItemsV2_().filter(x=>x.day>=sc.fromDay&&x.day<=sc.toDay&&x.active&&!x.mastered);if(mode==='new')rows=rows.filter(x=>x.profile.attempts===0);if(mode==='weak')rows=rows.filter(x=>x.profile.state==='Weak'||x.profile.state==='Persistent Weak');if(mode==='difficult')rows=rows.filter(x=>x.difficult);shuffle_(rows);if(['new','weak'].includes(mode)){const n=Math.max(1,Math.min(100,Number(count||10)));rows=rows.slice(0,n);}return rows.map(x=>{const q=serveQuestion_(x.q);q.difficult=!!x.difficult;q.marked=!!x.starred;return q;});}
