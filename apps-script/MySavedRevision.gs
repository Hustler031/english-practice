function mySavedRevisionItemsV2_(){
  const words=myWordsRows_().filter(x=>truthy_(x.Active)&&String(x.Practice_Question_ID||'').trim()).sort((a,b)=>new Date(a.Created_At||0)-new Date(b.Created_At||0)),qmap=Object.fromEntries(allQuestions_().map(q=>[q.id,q])),facts=performanceFactsV2_(),profiles=learningProfilesV2_(facts),stars=currentStarredMapV2_(),diff=centralDifficultMapV2_(),mastered=currentMasteredMapV2_(),seen=new Set(),out=[];words.forEach(w=>{const id=String(w.Practice_Question_ID||'').trim();if(!id||seen.has(id))return;const q=qmap[id];if(!q)return;seen.add(id);const date=dateKey_(w.Created_At)||dateKey_(w.Updated_At)||todayKey_(),day=typeof dailyDayNoV2_==='function'?dailyDayNoV2_(date):1,p=profiles[id]||learningProfileV2_([]);out.push({savedId:String(w.Saved_ID||''),id,day,date,word:String(w.Word||q.word||''),q,profile:p,starred:!!stars[id],difficult:!!diff[id],mastered:!!mastered[id],active:isActive_(q)});});return out;
